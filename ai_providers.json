{
  "_readme": "AI command-line tools Token Economy can use to analyze your data. The panel shows the ones found on PATH. 'input' says how the prompt is sent: 'stdin', 'file' ({file} is replaced by the prompt file path) or 'argument' ({prompt} is replaced by the prompt text; long prompts may hit the Windows 32k command-line limit). 'verified' marks flags checked against the tool's --help; the others follow the tool's docs and may need a tweak. Add your own entry here, or use 'Custom command' in the panel.",
  "cli": [
    {"id": "claude",   "name": "Claude Code",     "exe": "claude",       "input": "stdin",
     "args": ["-p", "--output-format", "text", "--no-session-persistence", "--strict-mcp-config", "--disallowedTools", "Bash", "PowerShell", "Edit", "Write", "Read", "Glob", "Grep", "WebFetch", "WebSearch", "Task", "NotebookEdit"],
     "model_arg": "--model", "verified": true},
    {"id": "codex",    "name": "Codex",           "exe": "codex",        "input": "stdin",
     "args": ["exec", "--skip-git-repo-check", "--ephemeral", "--sandbox", "read-only", "-"],
     "model_arg": "-m", "verified": true},
    {"id": "opencode", "name": "OpenCode",        "exe": "opencode",     "input": "file",
     "args": ["run", "--archived", "--file", "{file}", "Follow the instructions in the attached file. Reply with the JSON only."],
     "model_arg": "-m", "verified": true},
    {"id": "gemini",   "name": "Gemini CLI",      "exe": "gemini",       "input": "stdin",
     "args": ["-p", "Follow the instructions above. Reply with the JSON only."],
     "model_arg": "-m", "verified": false},
    {"id": "qwen",     "name": "Qwen Code",       "exe": "qwen",         "input": "stdin",
     "args": ["-p", "Follow the instructions above. Reply with the JSON only."],
     "model_arg": "-m", "verified": false},
    {"id": "grok",     "name": "Grok CLI",        "exe": "grok",         "input": "argument",
     "args": ["-p", "{prompt}"],
     "model_arg": "-m", "verified": false},
    {"id": "cursor",   "name": "Cursor Agent",    "exe": "cursor-agent", "input": "argument",
     "args": ["-p", "--output-format", "text", "{prompt}"],
     "model_arg": "-m", "verified": false},
    {"id": "copilot",  "name": "GitHub Copilot CLI", "exe": "copilot",   "input": "argument",
     "args": ["-p", "{prompt}"],
     "model_arg": "--model", "verified": false},
    {"id": "droid",    "name": "Factory Droid",   "exe": "droid",        "input": "file",
     "args": ["exec", "-f", "{file}"],
     "model_arg": "-m", "verified": false},
    {"id": "amp",      "name": "Amp",             "exe": "amp",          "input": "stdin",
     "args": ["-x"],
     "model_arg": null, "verified": false},
    {"id": "kimi",     "name": "Kimi CLI",        "exe": "kimi",         "input": "argument",
     "args": ["--print", "-c", "{prompt}"],
     "model_arg": "-m", "verified": false},
    {"id": "ollama",   "name": "Ollama (local)",  "exe": "ollama",       "input": "stdin",
     "args": ["run", "{model}"],
     "model_required": true, "verified": true}
  ]
}
