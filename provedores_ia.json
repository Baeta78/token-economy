{
  "_readme": "AI command-line tools Token Economy can use to analyze your data. The panel shows the ones found on PATH. 'entrada' says how the prompt is sent: 'stdin', 'arquivo' ({arquivo} is replaced by the prompt file path) or 'argumento' ({prompt} is replaced by the prompt text; long prompts may hit the Windows 32k command-line limit). 'verificado' marks flags checked against the tool's --help; the others follow the tool's docs and may need a tweak. Add your own entry here, or use 'Custom command' in the panel.",
  "cli": [
    {"id": "claude",   "nome": "Claude Code",     "exe": "claude",       "entrada": "stdin",
     "args": ["-p", "--output-format", "text", "--no-session-persistence", "--strict-mcp-config", "--disallowedTools", "Bash", "PowerShell", "Edit", "Write", "Read", "Glob", "Grep", "WebFetch", "WebSearch", "Task", "NotebookEdit"],
     "modelo_arg": "--model", "verificado": true},
    {"id": "codex",    "nome": "Codex",           "exe": "codex",        "entrada": "stdin",
     "args": ["exec", "--skip-git-repo-check", "--ephemeral", "--sandbox", "read-only", "-"],
     "modelo_arg": "-m", "verificado": true},
    {"id": "opencode", "nome": "OpenCode",        "exe": "opencode",     "entrada": "arquivo",
     "args": ["run", "--archived", "--file", "{arquivo}", "Follow the instructions in the attached file. Reply with the JSON only."],
     "modelo_arg": "-m", "verificado": true},
    {"id": "gemini",   "nome": "Gemini CLI",      "exe": "gemini",       "entrada": "stdin",
     "args": ["-p", "Follow the instructions above. Reply with the JSON only."],
     "modelo_arg": "-m", "verificado": false},
    {"id": "qwen",     "nome": "Qwen Code",       "exe": "qwen",         "entrada": "stdin",
     "args": ["-p", "Follow the instructions above. Reply with the JSON only."],
     "modelo_arg": "-m", "verificado": false},
    {"id": "grok",     "nome": "Grok CLI",        "exe": "grok",         "entrada": "argumento",
     "args": ["-p", "{prompt}"],
     "modelo_arg": "-m", "verificado": false},
    {"id": "cursor",   "nome": "Cursor Agent",    "exe": "cursor-agent", "entrada": "argumento",
     "args": ["-p", "--output-format", "text", "{prompt}"],
     "modelo_arg": "-m", "verificado": false},
    {"id": "copilot",  "nome": "GitHub Copilot CLI", "exe": "copilot",   "entrada": "argumento",
     "args": ["-p", "{prompt}"],
     "modelo_arg": "--model", "verificado": false},
    {"id": "droid",    "nome": "Factory Droid",   "exe": "droid",        "entrada": "arquivo",
     "args": ["exec", "-f", "{arquivo}"],
     "modelo_arg": "-m", "verificado": false},
    {"id": "amp",      "nome": "Amp",             "exe": "amp",          "entrada": "stdin",
     "args": ["-x"],
     "modelo_arg": null, "verificado": false},
    {"id": "kimi",     "nome": "Kimi CLI",        "exe": "kimi",         "entrada": "argumento",
     "args": ["--print", "-c", "{prompt}"],
     "modelo_arg": "-m", "verificado": false},
    {"id": "ollama",   "nome": "Ollama (local)",  "exe": "ollama",       "entrada": "stdin",
     "args": ["run", "{modelo}"],
     "modelo_obrigatorio": true, "verificado": true}
  ]
}
